# Synthetic rehearsal only. Never copy the ordinary service environment here.
LIANGXIANG_REHEARSAL=1
LIANGXIANG_AUTHORITY_MODE=DEV_STAGING_ONLY
LIANGXIANG_BACKEND_HOST=127.0.0.1
LIANGXIANG_BACKEND_PORT=4195
LIANGXIANG_BACKEND_DB=/var/lib/liangxiang/rehearsal/liangxiang-rehearsal.sqlite
LIANGXIANG_REHEARSAL_CLOCK_FILE=/var/lib/liangxiang/rehearsal/clock.json
LIANGXIANG_BUSINESS_TZ=Asia/Shanghai
LIANGXIANG_SNAPSHOT_SECONDS=1
LIANGXIANG_TOKEN_PER_INCENSE=50000
LIANGXIANG_ALLOW_UNSIGNED=0
